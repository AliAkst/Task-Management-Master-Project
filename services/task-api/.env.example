APP_NAME="Task Management MASTER"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_db

#JWT
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
#Rate Limiting
RATE_LIMITING_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Resilience Retry Settings
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=10.0
# RabbitMQ (opsiyonel - baglanamazsa event'ler atlanir, uygulama calismaya devam eder)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=taskuser
RABBITMQ_PASSWORD=taskpass
RABBITMQ_VHOST=taskhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend (CORS) - virgulle ayrilmis liste
CORS_ORIGINS=["http://localhost:5173"]
