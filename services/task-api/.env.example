APP_NAME="Task Management MASTER"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_db

#JWT
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
#Rate Limiting
RATE_LIMITING_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Resilience Retry Settings
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=10.0
# RabbitMQ (opsiyonel - baglanamazsa event'ler atlanir, uygulama calismaya devam eder)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=taskuser
RABBITMQ_PASSWORD=taskpass
RABBITMQ_VHOST=taskhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend (CORS) - virgulle ayrilmis liste
CORS_ORIGINS=["http://localhost:5173"]

# Google Takvim (Faz 7b) - Google Cloud Console > OAuth istemcisi (Web application)
# Yonlendirme adresi: http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft To Do (Faz 7c) - Azure portal > App registrations > "Personal Microsoft accounts only"
# Platform: Web, yonlendirme: http://localhost:8000/api/v1/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# OAuth donus adresleri (varsayilanlar yerel gelistirme icin dogru)
# API_BASE_URL=http://localhost:8000
# WEB_BASE_URL=http://localhost:5173
